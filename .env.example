# ==============================================================================
# DIGITAL LANDFILL — Environment Configuration Template
# Copy this file to `.env` (or set these variables in your deployment host)
# ==============================================================================

# Deployment Mode: 'local' (allows local filesystem scanning) or 'demo' (restricts to safe cloud demo dataset)
DEPLOYMENT_MODE=local

# Web Server Port (Render and cloud hosts will supply $PORT automatically)
PORT=8000

# CORS Allowed Origins (Comma-separated in production, e.g. https://your-frontend.onrender.com,https://yourdomain.com)
# When left empty in local mode, all localhost and 127.0.0.1 origins are permitted.
FRONTEND_ORIGIN=

# Default Demo Dataset Directory Path (Used in 'demo' deployment mode)
DEMO_DIR=test_waste_sample

# TCET Centre of Excellence AI Gateway Configuration (Qwen3.6-35B-A3B)
AI_KEY=your_tcet_coe_api_key_here
QWEN_BASE_URL=https://ai.tcetcercd.in/v1
QWEN_MODEL=qwen3.6
